{
  "ts-node": {
    "compilerOptions": {
      "target": "ES6",
      "module": "CommonJS",
      "moduleResolution": "Node16"
    }
  },
  "compilerOptions": {
    "module": "esnext",
    "lib": ["dom", "esnext"],
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "sourceMap": false,
    "declaration": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true
  },
  "types": ["vitest/globals", "vite/client"],
  "include": ["vite-env.d.ts", "./**/*.ts", "./**/*.tsx", "./*.js", "./*.ts"],
  "exclude": ["lib"]
}
