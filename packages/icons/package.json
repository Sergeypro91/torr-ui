{
  "name": "@torr-app/icons",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./sprite.svg": "./public/sprite.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergeypro91/torr-ui.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "minimize:svg": "svgo -f src/svg-raw -o src/svg-sources && rm src/svg-raw/*",
    "build:sprite-icon": "tsx src/build-icons.mts --log=verbose",
    "build": "tsup src/**/*.ts --dts --format esm,cjs --minify --clean"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "node-html-parser": "^7.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3"
  }
}
