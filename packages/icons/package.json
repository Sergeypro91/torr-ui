{
  "name": "@torr-app/icons",
  "version": "1.3.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./sprite.svg": "./public/sprite.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergeypro91/torr-ui.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "svg:minimize": "svgo -f src/svg-raw -o src/svg-sources && rm src/svg-raw/*",
    "sprite-icon:build": "tsx src/build-icons.mts --log=verbose",
    "build": "tsup",
    "publish": "npm publish --access public --workspaces",
    "check-update": "npx npm-check -u"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "node-html-parser": "^7.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "glob": "*",
    "tsx": "*"
  }
}
