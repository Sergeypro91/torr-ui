{
  "name": "torr-app",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build-packages": "npm run build-icons && npm run build-styles && npm run build-utils && npm run build-components",
    "build-components": "npm run build --workspace=@torr-app/components",
    "build-icons": "npm run build --workspace=@torr-app/icons",
    "build-styles": "npm run build --workspace=@torr-app/styles",
    "build-utils": "npm run build --workspace=@torr-app/utils",
    "bump-version": "npx @changesets/cli add && npx @changesets/cli version",
    "release": "npm run build-packages && npx @changesets/cli publish",
    "check:formatter": "npx @biomejs/biome format",
    "fix:format": "npx @biomejs/biome format --write",
    "check:linter": "npx @biomejs/biome lint",
    "fix:lint": "npx @biomejs/biome lint --write",
    "check:types": "tsc --noEmit",
    "lint:all": "npm run check:formatter && npm run check:linter && npm run check:types",
    "storybook": "storybook dev -p 5001",
    "storybook:doctor": "npx storybook doctor",
    "build-storybook": "storybook build",
    "check_package_update": "npx npm-check -u"
  },
  "dependencies": {
    "@torr-app/icons": "*",
    "@torr-app/styles": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0-beta.6",
    "@changesets/cli": "^2.29.4",
    "@chromatic-com/storybook": "^4.0.0",
    "@storybook/addon-a11y": "^9.0.9",
    "@storybook/addon-docs": "^9.0.9",
    "@storybook/addon-themes": "^9.0.9",
    "@storybook/addon-vitest": "^9.0.9",
    "@storybook/react-vite": "^9.0.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser": "^3.2.3",
    "@vitest/coverage-v8": "^3.2.3",
    "globals": "^16.2.0",
    "playwright": "^1.53.0",
    "storybook": "^9.0.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
