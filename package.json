{
  "name": "torr-app",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format:check": "npx @biomejs/biome format",
    "format:fix": "npx @biomejs/biome format --write",
    "lint:check": "npx @biomejs/biome lint",
    "lint:fix": "npx @biomejs/biome lint --write",
    "types:check": "tsc --noEmit",
    "lint:all": "npm run format:check && npm run lint:check && npm run types:check",
    "packages:build": "npm run build --workspace=@torr-app/utils && npm run build --workspace=@torr-app/styles && npm run build --workspace=@torr-app/icons && npm run build --workspace=@torr-app/components",
    "packages:check-update": "npx npm-check -u && npm run check-update --workspace=@torr-app/utils && npm run check-update --workspace=@torr-app/styles && npm run check-update --workspace=@torr-app/icons && npm run check-update --workspace=@torr-app/components",
    "packages:bump-version": "npx @changesets/cli add && npx @changesets/cli version",
    "packages:release": "npm run packages:build && npx @changesets/cli publish",
    "storybook:dev": "storybook dev -p 5001",
    "storybook:doctor": "npx storybook doctor",
    "storybook:build": "storybook build",
    "storybook:serve": "npx http-server storybook-static"
  },
  "dependencies": {
    "@torr-app/icons": "*",
    "@torr-app/styles": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0-beta.6",
    "@changesets/cli": "^2.29.4",
    "@chromatic-com/storybook": "^4.0.0",
    "@storybook/addon-a11y": "^9.0.9",
    "@storybook/addon-docs": "^9.0.9",
    "@storybook/addon-themes": "^9.0.9",
    "@storybook/addon-vitest": "^9.0.9",
    "@storybook/react-vite": "^9.0.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/browser": "^3.2.3",
    "@vitest/coverage-v8": "^3.2.3",
    "globals": "^16.2.0",
    "playwright": "^1.53.0",
    "storybook": "^9.0.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
